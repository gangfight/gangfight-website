---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { defaultLocale, locales, path, t, type Locale } from '../i18n'

interface Props {
  locale: Locale
  title?: string
  description?: string
  // The page below the locale root ('' is the start page), used for the
  // language switch and the alternate links.
  page?: string
  robots?: string
}

const { locale, title, description, page = '', robots } = Astro.props
const m = t(locale)
const other: Locale = locale === 'en' ? 'de' : 'en'
const site = Astro.site ?? new URL('https://www.gangfight.eu')
const canonical = new URL(path(locale, page), site)
---

<!doctype html>
<html lang={m.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? m.title}</title>
    <meta name="description" content={description ?? m.description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(path(l, page), site)} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(path(defaultLocale, page), site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={m.name} />
    <meta property="og:title" content={title ?? m.title} />
    <meta property="og:description" content={description ?? m.description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#14110f" />
  </head>
  <body>
    <a class="skip" href="#main">
      {m.skip}
    </a>
    <Header locale={locale} switchTo={other} switchHref={path(other, page)} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
